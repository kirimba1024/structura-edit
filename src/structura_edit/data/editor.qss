QWidget { color: $TEXT; font-family: Monocraft; font-size: ${FONT_SIZE}px; }
QLabel#appTitle { font-size: ${TITLE_FONT_SIZE}px; }
QMainWindow, QDialog, QDockWidget, QStatusBar, QMenuBar, QMenu { background: $PANEL_BACKGROUND; }
QWidget#panelTitle { background: $PANEL_PRESSED; border-bottom: 1px solid $BORDER; }
QStatusBar { border-top: 1px solid $BORDER; }
QStatusBar::item { border: 0; }
QWidget#placementBar { background: $PANEL_BACKGROUND; border-top: 1px solid $BORDER; }
QLabel[cell="true"] { background: $PANEL_PRESSED; border: 1px solid $BORDER; padding: 1px 4px; }
QPushButton, QToolButton {
    background: $PANEL_BACKGROUND; border: 1px solid $BORDER; border-radius: 0;
    padding: 1px 4px; min-height: ${CONTROL_CONTENT}px; max-height: ${CONTROL_CONTENT}px;
}
QPushButton:hover, QToolButton:hover { background: $PANEL_HOVER; }
QPushButton:pressed, QToolButton:pressed, QToolButton:checked { background: $PANEL_PRESSED; }
QPushButton:focus, QToolButton:focus, QPushButton:default { border-color: $ACCENT; }
QWidget:disabled { color: $BORDER; }
QLineEdit, QPlainTextEdit, QAbstractSpinBox, QComboBox, QAbstractItemView {
    background: #fffdf0; border: 1px solid $BORDER; border-radius: 0;
    selection-background-color: $ACCENT; selection-color: white;
}
QLineEdit, QAbstractSpinBox, QComboBox { min-height: ${CONTROL_CONTENT}px; max-height: ${CONTROL_CONTENT}px; padding: 1px 4px; }
QLineEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus, QComboBox:focus { border-color: $ACCENT; }
QAbstractSpinBox { padding-right: 16px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button {
    width: 16px; background: $PANEL_BACKGROUND; border: 1px solid $BORDER;
    subcontrol-origin: border;
}
QAbstractSpinBox::up-button { subcontrol-position: top right; border-bottom: 1px solid $BORDER; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover, QComboBox::drop-down:hover { background: $PANEL_HOVER; }
QAbstractSpinBox::up-arrow { image: url("$ASSETS/up.svg"); width: 7px; height: 4px; }
QAbstractSpinBox::down-arrow, QComboBox::down-arrow { image: url("$ASSETS/down.svg"); width: 7px; height: 4px; }
QComboBox { padding-right: 20px; }
QComboBox::drop-down { width: 20px; border-left: 1px solid $BORDER; }
QComboBox QAbstractItemView { outline: 0; }
QCheckBox {
    background: $PANEL_BACKGROUND; border: 1px solid $BORDER; padding: 1px 4px; spacing: 8px;
    min-height: ${CONTROL_CONTENT}px; max-height: ${CONTROL_CONTENT}px;
}
QCheckBox:hover { background: $PANEL_HOVER; }
QCheckBox:checked { background: $PANEL_PRESSED; }
QCheckBox:focus { border-color: $ACCENT; }
QCheckBox::indicator { width: 14px; height: 14px; border: 1px solid $BORDER; background: #fffdf0; }
QCheckBox::indicator:checked { image: url("$ASSETS/check.svg"); }
QCheckBox::indicator:focus { border-color: $ACCENT; }
QMenuBar::item { padding: 2px 8px; background: transparent; }
QMenuBar::item:selected, QMenu::item:selected { background: $ACCENT; color: white; }
QMenu { border: 1px solid $BORDER; padding: 0; }
QMenu::item { padding: 2px 24px; }
QMenu::separator { height: 1px; background: $BORDER; margin: 4px 0; }
QMenu::indicator:checked { image: url("$ASSETS/check.svg"); }
QHeaderView::section { background: $PANEL_PRESSED; border: 0; border-right: 1px solid $BORDER; padding: 2px 4px; }
QAbstractItemView { outline: 0; }
QAbstractItemView::item { padding: 2px 4px; }
QScrollBar { background: $PANEL_PRESSED; border: 0; }
QScrollBar:vertical { width: 12px; margin: 0; }
QScrollBar:horizontal { height: 12px; margin: 0; }
QScrollBar::handle { background: $BORDER; min-height: 24px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QToolTip { color: $TEXT; background: $PANEL_BACKGROUND; border: 1px solid $BORDER; padding: 4px; }
QWidget#minimap QToolButton { min-height: ${MAP_HEADER_HEIGHT}px; max-height: ${MAP_HEADER_HEIGHT}px; padding: 0 4px; border-top: 0; border-bottom: 0; border-right: 0; }
QWidget#minimap QToolButton#mapExpand { border-right: 1px solid $BORDER; }
